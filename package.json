{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "npm run quality && next build && node build-banner.js",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "quality": "npm run lint:ts && npm run lint:scss && npm run format:check",
    "quality:fix": "npm run lint:ts:fix && npm run lint:scss:fix && npm run format",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:scss:fix": "stylelint \"**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "nanoid": "6.0.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.108.2"
  },
  "devDependencies": {
    "@romashka_rv/frontend-config": "4.0.0",
    "@svgr/webpack": "8.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chalk": "6.0.1",
    "eslint": "10.14.0",
    "figlet": "1.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-html-props": "2.1.1",
    "string-replace-loader": "3.3.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --fix --no-warn-ignored",
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
